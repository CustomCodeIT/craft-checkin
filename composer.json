{
  "name": "customcodeit/craft-checkin",
  "description": "Provides an endpoint that returns information about your Craft instance.",
  "type": "craft-plugin",
  "license": "MIT",
  "support": {
    "email": "hello@customcodeit.com.au",
    "issues": "",
    "source": "",
    "docs": ""
  },
  "authors": [
    {
      "name": "Custom Code IT",
      "homepage": "https://customcodeit.com.au"
    }
  ],
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.0.0"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "customcodeit\\checkin\\": "src/"
    }
  },
  "extra": {
    "handle": "checkin",
    "class": "customcodeit\\checkin\\CheckIn",
    "name": "CheckIn",
    "developer": "Custom Code IT",
    "documentationUrl": ""
  },
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "php-http/discovery": true,
      "yiisoft/yii2-composer": true
    }
  }
}
